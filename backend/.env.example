APP_NAME=ResearchFlow API
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.5
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_ENABLE_QUERY_REWRITE=true
LLM_ENABLE_REPORT_POLISH=false

SEARCH_PROVIDER=tavily
SEARCH_FALLBACK_PROVIDER=duckduckgo
SEARCH_API_KEY=your-search-api-key
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TOP_K=5
SEARCH_SNIPPET_MAX_CHARS=400
SEARCH_TIMEOUT_SECONDS=20

HISTORY_STORAGE_DIR=workspace/history
EXPORT_STORAGE_DIR=workspace/exports
CACHE_STORAGE_DIR=workspace/cache
